APP_NAME=Sistema de Gerenciamento de Entregas
APP_ENV=development
# Development/test podem usar SQLite; production deve usar PostgreSQL.
# Em production, o schema deve ser preparado por Alembic e o seed não roda automaticamente.
DATABASE_URL=sqlite:///./test_entregas.db

JWT_SECRET=troque-este-segredo-em-producao-com-mais-de-32-bytes
JWT_EXPIRES_MINUTES=480
CORS_ORIGINS=*
SEED_DATABASE=true

GOOGLE_MAPS_API_KEY=...
GOOGLE_MAPS_RESTRICTED_KEY=opcional

# Valores suportados: google ou nominatim
GEOCODING_PROVIDER=google
MAPS_DEFAULT_CENTER=-00.000000,-00.000000

USE_GOOGLE_ROUTE_OPTIMIZATION=true

GOOGLE_ROUTE_OPTIMIZATION_PROJECT_ID=...

# O Project ID também pode ser consultado no arquivo JSON da credencial
# da Service Account, explicado nos comentários abaixo.

GOOGLE_ROUTE_OPTIMIZATION_LOCATION=us-central1

GOOGLE_ROUTE_OPTIMIZATION_SERVICE_ACCOUNT_FILE=...

# ============================================================
# CREDENCIAL DA GOOGLE ROUTE OPTIMIZATION
# ============================================================
#
# Para utilizar a otimização real de rotas com a Google Route
# Optimization API, crie uma pasta chamada "secrets" dentro
# de backend-api:
#
# backend-api/
# └── secrets/
#     └── nome-do-arquivo.json
#
# O arquivo JSON é a credencial da Service Account utilizada
# pela Google Cloud.
#
# Depois informe o caminho relativo desse arquivo na variável:
#
# GOOGLE_ROUTE_OPTIMIZATION_SERVICE_ACCOUNT_FILE=backend-api/secrets/nome-do-arquivo.json
#
# Não faça commit do arquivo JSON de credenciais.
# A pasta/arquivos de secrets devem permanecer ignorados pelo Git.
#
# Se essa credencial não estiver configurada, o sistema básico
# poderá iniciar, mas a otimização real pela Google ficará
# indisponível.

GOOGLE_ROUTE_OPTIMIZATION_SCOPE=https://www.googleapis.com/auth/cloud-platform

# Opcional: sobrescreve o endpoint padrão da Route Optimization API.
GOOGLE_ROUTE_OPTIMIZATION_ENDPOINT=

MAPTILER_API_KEY=...

# Opcional: sobrescreve a URL padrão do backend usada pelo frontend.
# No desktop local, o fallback é http://127.0.0.1:8000/api
API_BASE_URL=