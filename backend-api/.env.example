APP_NAME=Sistema de Gerenciamento de Entregas
APP_ENV=development
DATABASE_URL=sqlite:///./test_entregas.db

JWT_SECRET=troque-este-segredo-em-producao-com-mais-de-32-bytes
JWT_EXPIRES_MINUTES=480
CORS_ORIGINS=*
SEED_DATABASE=true

GOOGLE_MAPS_API_KEY= ...
GOOGLE_MAPS_RESTRICTED_KEY= opicional

# Valores suportados: google ou nominatim
GEOCODING_PROVIDER=google
MAPS_DEFAULT_CENTER=-00.000000,-00.000000

USE_GOOGLE_ROUTE_OPTIMIZATION=true
GOOGLE_ROUTE_OPTIMIZATION_PROJECT_ID=...
GOOGLE_ROUTE_OPTIMIZATION_LOCATION=us-central1
GOOGLE_ROUTE_OPTIMIZATION_SERVICE_ACCOUNT_FILE= ...
GOOGLE_ROUTE_OPTIMIZATION_SCOPE=https://www.googleapis.com/auth/cloud-platform

# Opcional: sobrescreve o endpoint padrão da Route Optimization API.
# GOOGLE_ROUTE_OPTIMIZATION_ENDPOINT=

MAPTILER_API_KEY= ...

# Opcional: sobrescreve a URL padrão do backend usada pelo frontend.
# No desktop local, o fallback é http://127.0.0.1:8000/api
# API_BASE_URL=
